<!--
  The shell skeleton (ledger shell-layout-skeleton): header, ribbon, the app row (left panel and
  canvas area), the status strip row, footer, top to bottom (styles.css:99-108, editor.html:15-343).
  4.1 has no right panel: .rpanel (styles.css:462-469) is styled but never used, so it is not ported. The one
  right-hand column is new in v5.1: the 3D avatar preview (PreviewColumn, ledger avatar-preview-3d).
  This is the final M3a file: Task 2's CanvasView in the CanvasArea, Task 3's HomeRibbon in the
  RibbonPane, and Task 4's drop zone, layers panel and status strip.
-->
<Window x:Class="RBX15.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RBX15.App.Views"
        xmlns:vm="clr-namespace:RBX15.App.ViewModels"
        xmlns:app="clr-namespace:RBX15.App"
        xmlns:conv="clr-namespace:RBX15.App.Converters"
        x:Name="Root"
        Title="{Binding Title}"
        Icon="pack://application:,,,/RBX15.App;component/app.ico"
        Width="{x:Static app:ShellLayout.DefaultWidth}" Height="{x:Static app:ShellLayout.DefaultHeight}"
        MinWidth="{x:Static app:ShellLayout.MinWidth}" MinHeight="{x:Static app:ShellLayout.MinHeight}"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource Fg2Brush}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <!-- Ctrl+Z, Ctrl+S, Ctrl+Shift+S and Ctrl+O are added in MainWindow.xaml.cs (AddShortcut) behind TextFieldShortcutCommand.
       The title is MainViewModel.Title (M4a R3). While an Open reads its file the whole client takes no input (R4). -->

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:EnumMatchConverter x:Key="TabMatch" />
    <conv:EqualsMultiConverter x:Key="Equal" />
    <!-- A ribbon pane is Visible only while its tab is the active one; Hidden (not Collapsed) keeps its size in the shared cell. -->
    <Style x:Key="RibbonPaneHost" TargetType="UserControl">
      <Setter Property="Visibility" Value="Hidden" />
      <Style.Triggers>
        <DataTrigger Value="True">
          <DataTrigger.Binding>
            <MultiBinding Converter="{StaticResource Equal}">
              <Binding Path="DataContext.ActiveTab" ElementName="Root" />
              <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </DataTrigger.Binding>
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Viewport" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header (styles.css:129-155): padding 10px 24px, gap 16px, 135deg navy / navy-deep / navy,
         1px border-accent bottom, shadow 0 2px 8px rgba(0,0,0,.35); drawn above the ribbon. -->
    <Border x:Name="Header" Grid.Row="0" Panel.ZIndex="1" Padding="24,10"
            BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="{StaticResource BrandNavyColor}" />
          <GradientStop Offset="0.5" Color="{StaticResource BrandNavyDeepColor}" />
          <GradientStop Offset="1" Color="{StaticResource BrandNavyColor}" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- header h1 (styles.css:139-148): Space Grotesk 20px 600, text filled with the brand gradient. -->
        <TextBlock x:Name="HeaderTitle" Text="{Binding HeaderTitle, Mode=OneTime}" VerticalAlignment="Center"
                   FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource BrandGradientBrush}" />
        <!-- The 626Labs mark in place of 4.1's "ItsjustEste" (Este, 2026-10-17; ledger shell-header): bold duo, no "LLC". -->
        <Image x:Name="HeaderMark" Source="{StaticResource LabsMarkDuo}" Height="18" Margin="16,0,0,0" VerticalAlignment="Center"
               AutomationProperties.Name="626Labs" />
        <!-- header span (styles.css:149-155): JetBrains Mono 11px fg-3 uppercase; gap 16px (:133). Now the version only. -->
        <TextBlock x:Name="HeaderByline" Margin="12,0,0,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource Fg3Brush}"
                   Text="{Binding HeaderByline, Mode=OneTime, Converter={StaticResource UpperCase}}" />
      </StackPanel>
    </Border>

    <!-- .ribbon (styles.css:160-164): 180deg navy-deep to ink-900, 1px border-1 bottom. -->
    <Border x:Name="Ribbon" Grid.Row="1" BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="{StaticResource BrandNavyDeepColor}" />
          <GradientStop Offset="1" Color="{StaticResource Ink900Color}" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <!-- .ribbon-tabs (styles.css:165-170): padding 0 8px, 180deg ink-950 to ink-900, 1px border-1 bottom.
             Home, Layout, Details and Text in 4.1's order (editor.html:23-27), bound two-way to MainViewModel.ActiveTab.
             Layout, Details and Text are Collapsed until their pane has a group (IRibbonPane.HasGroups; the hide rule). -->
        <Border DockPanel.Dock="Top" Padding="8,0" BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,0,1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="{StaticResource Ink950Color}" />
              <GradientStop Offset="1" Color="{StaticResource Ink900Color}" />
            </LinearGradientBrush>
          </Border.Background>
          <!-- The tabs carry no GroupName: a named RadioButton group is process-wide, so a second window would
               uncheck this one's tab. Unnamed, they group by this per-window parent panel (final fix wave 6). -->
          <!-- Each tab is its own Tab stop (a WPF radio group stops once, at the checked one) and the arrows do not move
               between tabs (K1: arrows are not tab navigation). Space checks a tab as RadioButton does; Enter is added in MainWindow.xaml.cs. -->
          <StackPanel x:Name="RibbonTabs" Orientation="Horizontal"
                      KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="None">
            <RadioButton x:Name="HomeTab" Style="{StaticResource RibbonTab}" Content="Home" AutomationProperties.Name="Home tab"
                         IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource TabMatch}, ConverterParameter=Home}" />
            <RadioButton x:Name="LayoutTab" Style="{StaticResource RibbonTab}" Content="Layout" AutomationProperties.Name="Layout tab"
                         IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource TabMatch}, ConverterParameter=Layout}" />
            <RadioButton x:Name="DetailsTab" Style="{StaticResource RibbonTab}" Content="Details" AutomationProperties.Name="Details tab"
                         IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource TabMatch}, ConverterParameter=Details}" />
            <RadioButton x:Name="TextTab" Style="{StaticResource RibbonTab}" Content="Text" AutomationProperties.Name="Text tab"
                         IsChecked="{Binding ActiveTab, Mode=TwoWay, Converter={StaticResource TabMatch}, ConverterParameter=Text}" />
          </StackPanel>
        </Border>
        <!-- .ribbon-pane.active (styles.css:197-198): padding 8px 12px, groups in a row that never
             shrink and scroll horizontally (ledger ribbon-overflow-hscroll). Task 3 puts HomeRibbon
             inside; HomeRibbon is the pane, so it brings its own ScrollViewer and its 12,8 margin. -->
        <!-- The four panes share one cell (R1: the ribbon keeps the tallest pane's height); the inactive ones are Hidden,
             which keeps their size. Switching tabs changes this visibility only, never the document. -->
        <Grid x:Name="RibbonPane">
          <views:HomeRibbon x:Name="HomePane" DataContext="{Binding Home}"
                            Style="{StaticResource RibbonPaneHost}" Tag="{x:Static vm:RibbonTab.Home}" />
          <views:LayoutRibbon x:Name="LayoutPane" DataContext="{Binding Layout}" Style="{StaticResource RibbonPaneHost}" Tag="{x:Static vm:RibbonTab.Layout}" />
          <views:DetailsRibbon x:Name="DetailsPane" DataContext="{Binding Details}" Style="{StaticResource RibbonPaneHost}" Tag="{x:Static vm:RibbonTab.Details}" />
          <views:TextRibbon x:Name="TextPane" DataContext="{Binding Text}" Style="{StaticResource RibbonPaneHost}" Tag="{x:Static vm:RibbonTab.Text}" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- .app (styles.css:241): the left panel and the canvas area. -->
    <Grid x:Name="AppRow" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PanelColumn" Width="280" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PreviewColumn" Width="260" />
      </Grid.ColumnDefinitions>

      <!-- .panel (styles.css:246-253): 280px (200px at the breakpoint), 180deg navy-deep to ink-900,
           1px border-1 right, padding 14px, vertical scroll. The drop zone, then the layers
           (editor.html:311-318), both on the LayersViewModel (Task 4). -->
      <Border x:Name="LeftPanel" Grid.Column="0" BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,0,1,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource BrandNavyDeepColor}" />
            <GradientStop Offset="1" Color="{StaticResource Ink900Color}" />
          </LinearGradientBrush>
        </Border.Background>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="LeftPanelContent" Margin="14">
            <views:AssetLibraryPanel DataContext="{Binding Assets}" />
            <views:DropZone DataContext="{Binding Layers}" />
            <views:LayersPanel DataContext="{Binding Layers}" />
            <views:LayerPropertiesPanel DataContext="{Binding LayerProperties}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- .canvas-area (styles.css:441-450): ink-950. Task 2 fills it with the canvas host and zoom pill. -->
      <Grid x:Name="CanvasArea" Grid.Column="1" Background="{StaticResource Ink950Brush}" ClipToBounds="True">
        <views:CanvasView DataContext="{Binding Canvas}" />
        <!-- The "3D" edge tab (Este, 2026-10-18): only while the preview is closed, on the canvas's right edge, it opens
             the panel again. Rounded on its open side, a cyan edge on the side the panel slides back from. -->
        <Button x:Name="PreviewEdgeTab" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,0,0"
                Command="{Binding AvatarPreview.ShowCommand}" Cursor="Hand"
                AutomationProperties.Name="Show 3D preview" ToolTip="Show the 3D preview"
                FocusVisualStyle="{StaticResource FocusRing}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{StaticResource Fg2Brush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6,0,0,6" BorderBrush="{StaticResource BorderAccentBrush}"
                            BorderThickness="1,1,0,1" Padding="7,10" SnapsToDevicePixels="True">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Offset="0" Color="{StaticResource BrandNavySoftColor}" />
                          <GradientStop Offset="1" Color="{StaticResource BrandNavyColor}" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <StackPanel>
                        <!-- a small isometric cube -->
                        <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" StrokeThickness="1.3"
                              StrokeLineJoin="Round" Stroke="{StaticResource BrandCyanBrush}"
                              Data="M7,0 L14,3.5 L14,10.5 L7,14 L0,10.5 L0,3.5 Z M0,3.5 L7,7 L14,3.5 M7,7 L7,14" />
                        <TextBlock Text="3D" Margin="0,6,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource FontMono}"
                                   FontSize="10" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Fg1Brush}" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandCyanBrush}" />
                        <Setter TargetName="Chrome" Property="Effect">
                          <Setter.Value>
                            <DropShadowEffect Color="{StaticResource BrandCyanColor}" ShadowDepth="0" BlurRadius="10" Opacity="0.3" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AvatarPreview.IsVisible}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>

      <!-- The v5.1 3D preview column (spec, App): styled like the left panel, 1px border-1 on its LEFT, padding 14;
           260 wide (200 at the breakpoint), collapsed with width 0 when "3D preview" is unchecked. -->
      <Border x:Name="PreviewPanelHost" Grid.Column="2" BorderBrush="{StaticResource Border1Brush}" BorderThickness="1,0,0,0"
              Visibility="{Binding AvatarPreview.IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource BrandNavyDeepColor}" />
            <GradientStop Offset="1" Color="{StaticResource Ink900Color}" />
          </LinearGradientBrush>
        </Border.Background>
        <views:AvatarPreviewPanel x:Name="PreviewPanel" Margin="14" DataContext="{Binding AvatarPreview}" />
      </Border>
    </Grid>

    <!-- The status strip row (spec §4, new in v5), above the footer; collapsed with no message. -->
    <views:StatusStrip Grid.Row="3" DataContext="{Binding Status}" />

    <!-- footer (styles.css:678-689): 180deg ink-950 to ink-900, 1px border-1 top, padding 7px 24px,
         JetBrains Mono 10px fg-muted uppercase, centered. -->
    <Border x:Name="Footer" Grid.Row="4" Padding="24,7" BorderBrush="{StaticResource Border1Brush}" BorderThickness="0,1,0,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="{StaticResource Ink950Color}" />
          <GradientStop Offset="1" Color="{StaticResource Ink900Color}" />
        </LinearGradientBrush>
      </Border.Background>
      <TextBlock x:Name="FooterText" HorizontalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10"
                 Foreground="{StaticResource FgMutedBrush}"
                 Text="{Binding FooterText, Mode=OneTime, Converter={StaticResource UpperCase}}" />
    </Border>
  </Grid>
</Window>
