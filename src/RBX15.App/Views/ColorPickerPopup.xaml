<Window x:Class="RBX15.App.Views.ColorPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBX15.App.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Background="{DynamicResource Bg1Brush}"
        Foreground="{DynamicResource Fg2Brush}"
        FontFamily="{DynamicResource FontBody}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Color picker">
    <!-- The themed color picker (ledger fillstyle-color-pickers, fix; Este 2026-10-14), replacing the Win32
         ChooseColor dialog. Every brush is a theme token except the square's and the strip's gradients,
         which are the HSV model itself (white, black and the six hue stops), not styling. The sizes
         (200x140 square, 14 DIP strip, 12 DIP padding, 8 DIP gaps) are a new v5 surface; provisional;
         M3b look sign-off. -->
    <Border x:Name="Frame" BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1"
            Padding="12" CornerRadius="{DynamicResource RSmRadius}">
        <StackPanel>
            <!-- Saturation (x) and value (y, up is brighter) over the current hue -->
            <controls:SaturationValueSurface x:Name="SvSquare" Width="200" Height="140" Focusable="True" Cursor="Cross"
                  FocusVisualStyle="{DynamicResource FocusRing}" KeyboardNavigation.TabIndex="0"
                  AutomationProperties.Name="Saturation and brightness"
                  MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnPointerUp">
                <Border Background="{Binding HueHex}" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas ClipToBounds="False" IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarker" Width="12" Height="12" StrokeThickness="2"
                             Stroke="{DynamicResource Ink0Brush}" Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource Ink950Color}" ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </controls:SaturationValueSurface>

            <!-- Hue, 0 to 360 left to right -->
            <controls:HueSurface x:Name="HueStrip" Width="200" Height="14" Margin="0,8,0,0" Focusable="True" Cursor="Hand"
                  FocusVisualStyle="{DynamicResource FocusRing}" KeyboardNavigation.TabIndex="1"
                  AutomationProperties.Name="Hue"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnPointerUp">
                <Border CornerRadius="{DynamicResource RXsRadius}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFF0000" />
                            <GradientStop Offset="0.16666667" Color="#FFFFFF00" />
                            <GradientStop Offset="0.33333333" Color="#FF00FF00" />
                            <GradientStop Offset="0.5" Color="#FF00FFFF" />
                            <GradientStop Offset="0.66666667" Color="#FF0000FF" />
                            <GradientStop Offset="0.83333333" Color="#FFFF00FF" />
                            <GradientStop Offset="1" Color="#FFFF0000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas ClipToBounds="False" IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Width="6" Height="18" Canvas.Top="-2" BorderThickness="2"
                            BorderBrush="{DynamicResource Ink0Brush}" CornerRadius="{DynamicResource RXsRadius}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Ink950Color}" ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </controls:HueSurface>

            <!-- Old and new swatches, then the hex field. The swatches are pictures only: the hex field is the new
                 color, and its HelpText names the original, so a screen reader gets both. -->
            <DockPanel Margin="0,10,0,0">
                <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RXsRadius}" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="OldSwatch" Width="32" Height="24" Background="{Binding OriginalHex}"
                                ToolTip="Original color" />
                        <Border x:Name="NewSwatch" Width="32" Height="24" Background="{Binding Hex}"
                                ToolTip="New color" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="HexBox" Margin="8,0,0,0" KeyboardNavigation.TabIndex="2"
                         Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                         FontFamily="{DynamicResource FontMono}" FontSize="12" Padding="6,3" VerticalContentAlignment="Center"
                         Background="{DynamicResource Ink950Brush}" Foreground="{DynamicResource Fg1Brush}"
                         BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                         CaretBrush="{DynamicResource BrandCyanBrush}" SelectionBrush="{DynamicResource BrandCyanDimBrush}"
                         FocusVisualStyle="{DynamicResource FocusRing}"
                         AutomationProperties.Name="Hex color" ToolTip="Hex color (#rgb or #rrggbb)"
                         AutomationProperties.HelpText="{Binding OriginalHex, StringFormat=New color; original color {0}}"
                         LostKeyboardFocus="OnHexLostFocus" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="OK" MinWidth="64" KeyboardNavigation.TabIndex="3"
                        Style="{DynamicResource PrimaryButtonSm}" AutomationProperties.Name="OK" Click="OnOk" />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="64" Margin="8,0,0,0" KeyboardNavigation.TabIndex="4"
                        Style="{DynamicResource SecondaryButtonSm}" AutomationProperties.Name="Cancel" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
