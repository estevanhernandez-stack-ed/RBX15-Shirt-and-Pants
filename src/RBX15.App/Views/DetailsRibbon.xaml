<UserControl x:Class="RBX15.App.Views.DetailsRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RBX15.App.Views"
             AutomationProperties.Name="Details">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- .ribbon-pane.active (styles.css:197-198): padding 8px 12px, groups never shrink, horizontal scroll when narrow.
         Settings (editor.html:175-186), then Neckline, Edges, Seams and Accents (editor.html:187-222); DataContext:
         DetailsViewModel. The tab shows because the pane has groups (IRibbonPane.HasGroups). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Groups" Orientation="Horizontal" Margin="12,8">
            <views:DetailsSettingsGroup x:Name="Settings" />
            <views:DetailButtonsGroup x:Name="Neckline" DataContext="{Binding Groups[0]}" />
            <views:DetailButtonsGroup x:Name="Edges" DataContext="{Binding Groups[1]}" />
            <views:DetailButtonsGroup x:Name="Seams" DataContext="{Binding Groups[2]}" />
            <views:DetailButtonsGroup x:Name="Accents" DataContext="{Binding Groups[3]}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
