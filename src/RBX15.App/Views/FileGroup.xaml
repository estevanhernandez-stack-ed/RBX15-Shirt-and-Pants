<UserControl x:Class="RBX15.App.Views.FileGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Home tab's File group (editor.html:85-97; ledger home-file-group). DataContext:
         FileGroupViewModel. Row 1 is Save work, Open, Recent and Add image, row 2 Download template, in 4.1's order and labels
         with its title= tooltips (editor.html:88-90, :93). .ribbon-group-items.vert: column, stretch, gap 4
         (styles.css:207-208); each row is a flex row with gap 3 (editor.html:87, :92); .btn-sm is padding 5px 10px, 11px
         (styles.css:407). Save As has no button (interfaces §2.1): Ctrl+Shift+S. M5 item 5 adds Recent beside Open (decision
         H1): the last 10 projects in a drop-down, a SecondaryButton at the same padding and size as its neighbors. -->
    <UserControl.Resources>
        <!-- A Recent entry: the file name, left aligned, on the menu's surface; a cyan edge on hover and keyboard focus. -->
        <Style x:Key="RecentItemButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource RSmRadius}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{DynamicResource RibbonGroup}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="FILE" Style="{DynamicResource RibbonGroupLabel}" />
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="NewButton"
                            Content="New"
                            ToolTip="Open a new, empty RBX15 window."
                            AutomationProperties.Name="New"
                            Command="{Binding NewCommand}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,3,0"
                            Style="{DynamicResource SecondaryButton}" />
                    <Button x:Name="SaveButton"
                            Content="Save work"
                            ToolTip="Save your workspace. Reopen and keep editing."
                            Command="{Binding SaveCommand}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,3,0"
                            Style="{DynamicResource SecondaryButton}" />
                    <Button x:Name="OpenButton"
                            Content="Open"
                            ToolTip="Open a saved workspace."
                            Command="{Binding OpenCommand}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,3,0"
                            Style="{DynamicResource SecondaryButton}" />
                    <!-- Content stays the string "Recent" (the Home tests find buttons by it); the template draws the drop-down chevron after it. -->
                    <Button x:Name="RecentButton"
                            Content="Recent"
                            ToolTip="Open one of the last 10 projects you saved or opened."
                            AutomationProperties.Name="Recent projects"
                            Click="OnRecent"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,3,0"
                            Style="{DynamicResource SecondaryButton}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" />
                                    <Path Data="M0,0 L3.5,4 L7,0" Stroke="{DynamicResource Fg1Brush}" StrokeThickness="1.2"
                                          Margin="5,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <!-- Below the button; a click anywhere else closes it (StaysOpen false). It takes its DataContext through the logical tree. -->
                    <Popup x:Name="RecentPopup" PlacementTarget="{Binding ElementName=RecentButton}" Placement="Bottom"
                           StaysOpen="False" Opened="OnRecentOpened" Closed="OnRecentClosed" AllowsTransparency="False">
                        <Border x:Name="RecentFrame" DataContext="{Binding Recent}" Background="{DynamicResource Bg1Brush}"
                                BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1" Padding="4" MinWidth="180" MaxWidth="360">
                            <StackPanel>
                                <TextBlock x:Name="RecentEmpty" Text="No recent projects yet." Margin="8,4" FontSize="11"
                                           Foreground="{DynamicResource FgMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl x:Name="RecentList" ItemsSource="{Binding Items}" IsTabStop="False" Focusable="False"
                                              AutomationProperties.Name="Recent projects list">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RecentItemButton}" ToolTip="{Binding Path}"
                                                    AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Path}"
                                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Path}" Click="OnRecentItem">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="RecentClearRow">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Height="1" Margin="0,4" Background="{DynamicResource Border1Brush}" />
                                    <Button x:Name="RecentClear" Style="{StaticResource RecentItemButton}" Command="{Binding ClearCommand}"
                                            AutomationProperties.Name="Clear recent list" Click="OnRecentItem">
                                        <TextBlock Text="Clear recent list" Foreground="{DynamicResource Fg3Brush}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Content="Add image"
                            ToolTip="Add an image file as a layer."
                            Command="{Binding AddImageCommand}"
                            Padding="10,5"
                            FontSize="11"
                            Style="{DynamicResource SecondaryButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Download template"
                            ToolTip="Export the finished 585x559 PNG. Ready to upload to Roblox."
                            Command="{Binding DownloadTemplateCommand}"
                            Padding="10,5"
                            FontSize="11"
                            Style="{DynamicResource PrimaryButton}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
