<UserControl x:Class="RBX15.App.Views.LayoutRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RBX15.App.Views"
             AutomationProperties.Name="Layout">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- .ribbon-pane.active (styles.css:197-198): padding 8px 12px, groups never shrink, horizontal scroll when narrow.
         Presets (editor.html:113-124) is first; Background and BG Settings follow with M4b item 6. Fill Style and the region
         grid stay on Home (M4b decision F1). DataContext: LayoutViewModel. The tab shows once this panel has a group
         (IRibbonPane.HasGroups). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Groups" Orientation="Horizontal" Margin="12,8">
            <views:PresetsGroup x:Name="Presets" DataContext="{Binding Presets}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
