<UserControl x:Class="RBX15.App.Views.RegionsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Template Regions (editor.html:168-171; buildRegionGrid, editor.js:1624-1649). The last group: no right divider (styles.css:207). -->
    <Border Style="{StaticResource RibbonGroup}" BorderThickness="0">
        <DockPanel>
            <!-- 4.1 labelled it TEMPLATE REGIONS; v5 names what a click does (ledger ribbon-fill-regions-joined). -->
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="CLICK REGIONS TO FILL" />
            <!-- #regionGrid is a .ribbon-group-items row (styles.css:208): the cross and the limbs side by side, centered, 4px gap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- The body cross: 5 equal columns, 3 rows, 2px gap (editor.js:1625-1629). Body = Up, Right, Front, Left, Back, Down. -->
                <Grid x:Name="Cross" Grid.IsSharedSizeScope="True" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="CrossColumn" />
                        <ColumnDefinition SharedSizeGroup="CrossColumn" />
                        <ColumnDefinition SharedSizeGroup="CrossColumn" />
                        <ColumnDefinition SharedSizeGroup="CrossColumn" />
                        <ColumnDefinition SharedSizeGroup="CrossColumn" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter Grid.Row="0" Grid.Column="2" Content="{Binding Body[0]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="1" Content="{Binding Body[1]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding Body[2]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="3" Content="{Binding Body[3]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="4" Content="{Binding Body[4]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    <ContentPresenter Grid.Row="2" Grid.Column="2" Content="{Binding Body[5]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                </Grid>

                <!-- The limbs, two side by side, 4px gap. 4.1 offered only their four sides (editor.js:1630-1646), so the shoulder
                     top and the hand opening (rarm_up, rarm_down, ...) could never be filled; v5 adds Top and Bot above and below
                     Fr, where those regions sit on the template, making each limb a small cross as tall as the body's (Este,
                     2026-10-18; ledger regions-limb-caps). Right limb: L, Bk, R, Fr; left limb: Fr, L, Bk, R. -->
                <StackPanel x:Name="Limbs" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Grid x:Name="Limb1Cross" Grid.IsSharedSizeScope="True" Margin="0,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="Limb1Column" />
                            <ColumnDefinition SharedSizeGroup="Limb1Column" />
                            <ColumnDefinition SharedSizeGroup="Limb1Column" />
                            <ColumnDefinition SharedSizeGroup="Limb1Column" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LimbLabel}"
                                   Text="{Binding LimbLabel1}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,3" />
                        <ContentPresenter Grid.Row="0" Grid.Column="3" Content="{Binding Limb1Top}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="0" Content="{Binding Limb1[0]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="1" Content="{Binding Limb1[1]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding Limb1[2]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="3" Content="{Binding Limb1[3]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="2" Grid.Column="3" Content="{Binding Limb1Bot}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    </Grid>
                    <Grid x:Name="Limb2Cross" Grid.IsSharedSizeScope="True" Margin="2,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="Limb2Column" />
                            <ColumnDefinition SharedSizeGroup="Limb2Column" />
                            <ColumnDefinition SharedSizeGroup="Limb2Column" />
                            <ColumnDefinition SharedSizeGroup="Limb2Column" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource LimbLabel}"
                                   Text="{Binding LimbLabel2}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,3" />
                        <ContentPresenter Grid.Row="0" Grid.Column="0" Content="{Binding Limb2Top}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="0" Content="{Binding Limb2[0]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="1" Content="{Binding Limb2[1]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding Limb2[2]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="1" Grid.Column="3" Content="{Binding Limb2[3]}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                        <ContentPresenter Grid.Row="2" Grid.Column="0" Content="{Binding Limb2Bot}" ContentTemplate="{StaticResource RegionTileTemplate}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
