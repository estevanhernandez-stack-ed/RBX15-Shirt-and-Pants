<UserControl x:Class="RBX15.App.Views.TextRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Text">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HomeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- #waText (editor.html:228): 150 wide, min-height 36, #1a1a2e, 1px #333, #e0e0e0, padding 4x8, radius 4, 12px,
                 two rows. The hint is Chromium's darkGray, as TemplateNameBox's. The vertical drag handle (resize: vertical) is
                 not ported: the box scrolls, and the group stays one height. -->
            <Style x:Key="WordArtTextBox" TargetType="TextBox">
                <Setter Property="Width" Value="150" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinLines" Value="2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Background" Value="#1A1A2E" />
                <Setter Property="BorderBrush" Value="#333333" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="CaretBrush" Value="#E0E0E0" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#A9A9A9" FontSize="{TemplateBinding FontSize}"
                                               Margin="10,4,8,4" IsHitTestVisible="False" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- #waSize (editor.html:256): 44 wide, #1a1a2e, 1px #333, #e0e0e0, padding 1x4, radius 3, 10px -->
            <Style x:Key="WordArtNumberBox" TargetType="TextBox">
                <Setter Property="Width" Value="44" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="Background" Value="#1A1A2E" />
                <Setter Property="BorderBrush" Value="#333333" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="CaretBrush" Value="#E0E0E0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- #waFont (editor.html:230): 150 wide, #1a1a2e, 1px #333, #e0e0e0, padding 2x6, radius 4, 10px. Options are not drawn in their own face. -->
            <Style x:Key="WordArtComboItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2217D4FA" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4017D4FA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WordArtComboBox" TargetType="ComboBox">
                <Setter Property="Width" Value="150" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="#1A1A2E" />
                <Setter Property="BorderBrush" Value="#333333" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource WordArtComboItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Data="M0,0 L3,3 6,0"
                                                      Stroke="#888888" StrokeThickness="1.2" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Selected" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#1A1A2E" BorderBrush="#333333"
                                            BorderThickness="1" CornerRadius="4" Padding="0,2">
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The 8px #666 captions over the color wells and beside the sliders (editor.html:250-264) -->
            <Style x:Key="WordArtLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Foreground" Value="#666666" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- .wordart-style-btn (styles.css:605-623) at editor.html:269's padding 3x6 and 9px; .active = cyan border, rgba(23,212,250,.1), cyan text -->
            <Style x:Key="WordArtStyleItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource RXsRadius}" BorderThickness="1" Padding="6,3"
                                    Background="{DynamicResource BrandNavyBrush}" BorderBrush="{DynamicResource Border1Brush}">
                                <TextBlock x:Name="Caption" Text="{Binding Label}" FontFamily="{DynamicResource FontBody}" FontSize="9"
                                           FontWeight="Medium" Foreground="{DynamicResource Fg2Brush}" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                    <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BrandCyanBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="#1A17D4FA" />
                                    <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BrandCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- .ribbon-pane.active (styles.css:197-198): padding 8px 12px, groups never shrink, horizontal scroll when narrow.
         Text, Colors & Size, Style and Preview (editor.html:226-283); DataContext: TextViewModel. The tab shows because the
         pane has groups (IRibbonPane.HasGroups). The last group has no divider (styles.css:207). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Groups" Orientation="Horizontal" Margin="12,8">

            <!-- Text: the text box over the font select, gap 4 (.ribbon-group-items.vert) -->
            <Border x:Name="TextGroup" Style="{DynamicResource RibbonGroup}">
                <DockPanel>
                    <TextBlock Style="{DynamicResource RibbonGroupLabel}" Text="TEXT" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBox x:Name="WordArtText" Style="{StaticResource WordArtTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Type text..." Margin="0,0,0,4" AutomationProperties.Name="Word Art text" />
                        <ComboBox x:Name="FontBox" Style="{StaticResource WordArtComboBox}" ItemsSource="{Binding Fonts}"
                                  SelectedValuePath="Family" SelectedValue="{Binding Font}" AutomationProperties.Name="Word Art font">
                            <!-- An explicit template, not DisplayMemberPath: this style's hand-built template wires SelectionBoxItemTemplate only,
                                 so the closed box (and the list's bare ContentPresenters) fell back to the record's ToString (smoke P-1). -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Colors & Size: Fill, Stroke, Grad (28x20 wells) and Size over Stroke W and Angle, gap 4 -->
            <Border x:Name="ColorsGroup" Style="{DynamicResource RibbonGroup}">
                <DockPanel>
                    <TextBlock Style="{DynamicResource RibbonGroupLabel}" Text="COLORS &amp; SIZE" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource WordArtLabel}" Text="Fill" HorizontalAlignment="Center" />
                                <Button x:Name="FillWell" Style="{StaticResource ColorSwatchButton}" Width="28" Height="20" Background="{Binding FillColor}"
                                        Command="{Binding PickFillCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        ToolTip="Fill color" AutomationProperties.Name="Fill color" AutomationProperties.HelpText="{Binding FillColor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource WordArtLabel}" Text="Stroke" HorizontalAlignment="Center" />
                                <Button x:Name="StrokeWell" Style="{StaticResource ColorSwatchButton}" Width="28" Height="20" Background="{Binding StrokeColor}"
                                        Command="{Binding PickStrokeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        ToolTip="Stroke color" AutomationProperties.Name="Stroke color" AutomationProperties.HelpText="{Binding StrokeColor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource WordArtLabel}" Text="Grad" HorizontalAlignment="Center" />
                                <Button x:Name="GradWell" Style="{StaticResource ColorSwatchButton}" Width="28" Height="20" Background="{Binding GradColor}"
                                        Command="{Binding PickGradCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        ToolTip="Gradient end color" AutomationProperties.Name="Gradient end color" AutomationProperties.HelpText="{Binding GradColor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource WordArtLabel}" Text="Size" HorizontalAlignment="Center" />
                                <TextBox x:Name="SizeBox" Style="{StaticResource WordArtNumberBox}" Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Font size, 8 to 300" AutomationProperties.Name="Font size" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource WordArtLabel}" Text="Stroke W" Margin="0,0,4,0" />
                            <Slider x:Name="StrokeWidthSlider" Width="60" Minimum="0" Maximum="20" SmallChange="1" LargeChange="1" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding StrokeWidth}" VerticalAlignment="Center"
                                    FocusVisualStyle="{DynamicResource FocusRing}" Margin="0,0,4,0"
                                    ToolTip="Stroke width" AutomationProperties.Name="Stroke width" />
                            <TextBlock Style="{StaticResource WordArtLabel}" Text="Angle" Margin="0,0,4,0" />
                            <Slider x:Name="AngleSlider" Width="50" Minimum="0" Maximum="360" SmallChange="1" LargeChange="1" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding Angle}" VerticalAlignment="Center"
                                    FocusVisualStyle="{DynamicResource FocusRing}"
                                    ToolTip="Gradient angle" AutomationProperties.Name="Gradient angle" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Style: six buttons in a 3-column grid, gap 2 -->
            <Border x:Name="StyleGroup" Style="{DynamicResource RibbonGroup}">
                <DockPanel>
                    <TextBlock Style="{DynamicResource RibbonGroupLabel}" Text="STYLE" />
                    <ListBox x:Name="StyleList" ItemsSource="{Binding Styles}" SelectedValuePath="Style" SelectedValue="{Binding Style}"
                             ItemContainerStyle="{StaticResource WordArtStyleItem}" AutomationProperties.Name="Word Art style"
                             Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Preview: the black box (1px #333, radius 4, min-height 44) over Add to canvas, centered; no divider -->
            <Border x:Name="PreviewGroup" Style="{DynamicResource RibbonGroup}" BorderThickness="0">
                <DockPanel>
                    <TextBlock Style="{DynamicResource RibbonGroupLabel}" Text="PREVIEW" />
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="PreviewBox" Background="#000000" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" MinHeight="44"
                                HorizontalAlignment="Center" ClipToBounds="True" Margin="0,0,0,4" SnapsToDevicePixels="True">
                            <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="Word Art preview" />
                        </Border>
                        <Button x:Name="AddButton" Content="Add to canvas" Style="{DynamicResource PrimaryButtonSm}" FontSize="10" Padding="8,3"
                                Command="{Binding AddCommand}" AutomationProperties.Name="Add to canvas" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
