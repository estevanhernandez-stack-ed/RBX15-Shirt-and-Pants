<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- M4b item 8 (W1): the 15-font gate compiles once the controller's capture is committed (tools/parity-ref/freeze-wordart-fonts.py
       writes tests/goldens/app/wordart-fonts/index.json). Until then it is out of the build; nothing else changes. -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\tests\goldens\app\wordart-fonts\index.json')">
    <Compile Remove="GoldenWordArtFontTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RBX15.Engine\RBX15.Engine.csproj" />
    <ProjectReference Include="..\RBX15.Parity\RBX15.Parity.csproj" />
  </ItemGroup>

</Project>